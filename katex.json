{
    "name" : "katex",
    "buildsystem": "simple",
    "build-options": {
        "env": {
            "DEST": "/app/share/iotas/media/"
        }
    },
    "build-commands": [
        "mkdir -p ${DEST}/js/",
        "cp katex.min.js ${DEST}/js/",
        "mkdir -p ${DEST}/css/web/",
        "cp katex.min.css ${DEST}/css/web/",
        "mkdir -p ${DEST}/css/web/fonts/",
        "cp fonts/*.woff2 ${DEST}/css/web/fonts/"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/KaTeX/KaTeX/releases/download/v0.16.26/katex.tar.gz",
            "sha256": "3cde8dad9248042a497a92c7db4a6e97e8ba6f68f5eb9c77b9c2956a2731da42"
        }
    ]
}
