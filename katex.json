{
    "name" : "katex",
    "buildsystem": "simple",
    "build-options": {
        "env": {
            "DEST": "/app/share/iotas/media/"
        }
    },
    "build-commands": [
        "mkdir -p ${DEST}/js/",
        "cp katex.min.js ${DEST}/js/",
        "mkdir -p ${DEST}/css/web/",
        "cp katex.min.css ${DEST}/css/web/",
        "mkdir -p ${DEST}/css/web/fonts/",
        "cp fonts/*.woff2 ${DEST}/css/web/fonts/"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://github.com/KaTeX/KaTeX/releases/download/v0.18.1/katex.tar.gz",
            "sha256": "7f459e8b7b0a38462bc685f601c684da2dc86ba9c7ce3de68eb26861d6b56288"
        }
    ]
}
